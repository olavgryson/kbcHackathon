# Server-only secrets. Copy to .env.local and fill in. Never use a NEXT_PUBLIC_ prefix for these.
# LLM: any OpenAI-compatible endpoint (self-hosted vLLM/Ollama/TGI). Empty = demo mode.
LLM_BASE_URL=
LLM_API_KEY=

# Classifier: "fallback" (deterministic, always works) or "local" (jeff on 127.0.0.1)
CLASSIFIER_MODE=fallback
LOCAL_CLASSIFIER_URL=http://127.0.0.1:8765
# Optional: only if jeff-serve runs with JEFF_API_KEY
LOCAL_CLASSIFIER_API_KEY=

# Router
ROUTER_CONFIDENCE_THRESHOLD=0.6

# Models
MODEL_SIMPLE=llm-simple
MODEL_COMPLEX=llm-complex
